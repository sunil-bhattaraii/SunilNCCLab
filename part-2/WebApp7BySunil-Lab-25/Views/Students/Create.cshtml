<h1>Add Student</h1>

<form method="post" asp-action="CreateStudent">
  <label for="Name">Name: </label>
  <input type="text" name="Name" itemid="Name" placeholder="e.g. Ramesh Adhikari">

  <label for="Faculty">Faculty: </label>
  <input type="text" name="Faculty" itemid="Faculty" placeholder="e.g. Bsc CSIT"><br><br>

  <button type="submit">Create</button>
</form>
