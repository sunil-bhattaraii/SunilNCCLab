@model List<Student>

<h1 class="d-flex gap-5">Students List
  <a asp-controller="Students" asp-action="Create" class="btn btn-primary fw-bold">+ Add Student</a>

</h1>
<table cellpadding="8" class="table-bordered">
  <tr>
    <th>Roll</th>
    <th>Name</th>
    <th>Faculty</th>
    <th class="text-center">Actions</th>
  </tr>
  @{
    foreach (var s in Model)
    {
      <tr>
        <td>@s.Id</td>
        <td>@s.Name</td>
        <td>@s.Faculty</td>
        <td class="d-flex gap-3">
          <a asp-controller="Students" asp-action="Update" asp-route-id="@s.Id" class="btn btn-secondary">edit</a>
          <a asp-controller="Students" asp-action="DeleteStudent" asp-route-id="@s.Id" class="btn btn-danger"> delete</a>
        </td>
      </tr>
    }
  }
</table>
