@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    <form method="post" asp-action="RegisterUser">
        <input type="text value=" hidden Text" name="hidden" hidden>
        <label for="name">Tell me your name(I'll remember it): </label><br>
        <input type="text" name="Name">
        <button type="submit">Send</button>
    </form>

    @if (Context.Request.Query.ContainsKey("Info"))
    {
        <div class="alert alert-primary mt-4">
            @Context.Request.Query["Info"]
        </div>
    }
</div>
