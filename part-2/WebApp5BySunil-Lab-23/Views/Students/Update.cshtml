@model Student
<h1>Update Student Detail</h1>
<form asp-action="UpdateStudent" method="post">
  <label for="Roll">Roll No.: @Model.Roll</label>
  <input type="number" name="Roll" id="Roll" value="@Model.Roll" readonly hidden><br><br>

  <label for="Name">Name: </label>
  <input type="text" name="Name" itemid="Name" placeholder="e.g. Ramesh Adhikari" value="@Model.Name">

  <label for="Faculty">Faculty: </label>
  <input type="text" name="Faculty" itemid="Faculty" placeholder="e.g. Bsc CSIT" value="@Model.Faculty"><br><br>

  <button type="submit">Update</button>
</form>
