@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4 card p-4 shadow-sm">
        <h2 class="text-center mb-2">Login</h2>
        <p class="text-center text-muted">Sunil Bhattarai | Section B | Roll No. 63/080</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-success w-100">Log In</button>
        </form>
        <div class="mt-3 small text-muted">
            <p class="mb-1">Seeded accounts:</p>
            <p class="mb-0">Admin: admin@example.com / Admin@123 (role: Admin)<br />
               Normal: user@example.com / User@123 (role: User)</p>
        </div>
    </div>
</div>