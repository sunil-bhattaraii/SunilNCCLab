@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@model List<IdentityRole>
@{
    ViewData["Title"] = "Roles";
    // ViewBag.RoleClaims is Dictionary<string, IList<Claim>>
}

<h1>Roles</h1>
<p class="text-muted">Sunil Bhattarai | Section B | Roll No. 63/080</p>

@if (TempData["StatusMessage"] is not null)
{
    <div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<h5>Create New Role</h5>
<form asp-action="CreateRole" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="input-group" style="max-width:400px;">
        <input type="text" name="name" class="form-control" placeholder="New role name" required />
        <button type="submit" class="btn btn-success">Add Role</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">No roles defined yet.</p>
}

@foreach (var role in Model)
{
    var claims = ((Dictionary<string, IList<Claim>>)ViewBag.RoleClaims)[role.Id!];

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <strong>@role.Name</strong>

            <form asp-action="RenameRole" method="post" class="d-inline-flex align-items-center gap-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@role.Id" />
                <input type="text" name="name" value="@role.Name" class="form-control form-control-sm" style="width:180px" required />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Rename</button>
            </form>

            <form asp-action="DeleteRole" method="post" class="d-inline" onsubmit="return confirm('Delete role @role.Name?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@role.Id" />
                <button type="submit" class="btn btn-sm btn-outline-danger ms-auto">Delete</button>
            </form>
        </div>

        <div class="card-body">
            <h6>Claims for this role</h6>

            @if (claims.Any())
            {
                <table class="table table-sm table-bordered mb-2">
                    <thead class="table-light">
                        <tr><th>Type</th><th>Value</th><th style="width:200px">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in claims)
                        {
                            <tr>
                                <td>@c.Type</td>
                                <td>
                                    <form asp-action="UpdateRoleClaim" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roleId" value="@role.Id" />
                                        <input type="hidden" name="type" value="@c.Type" />
                                        <input type="text" name="value" value="@c.Value" class="form-control form-control-sm" style="width:150px;display:inline-block" required />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="DeleteRoleClaim" method="post" class="d-inline" onsubmit="return confirm('Delete claim?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roleId" value="@role.Id" />
                                        <input type="hidden" name="type" value="@c.Type" />
                                        <input type="hidden" name="value" value="@c.Value" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">No claims assigned to this role.</p>
            }

            <form asp-action="AddRoleClaim" method="post" class="d-flex gap-2 mt-2" style="max-width:500px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" value="@role.Id" />
                <input type="text" name="type" placeholder="Claim type" class="form-control form-control-sm" required />
                <input type="text" name="value" placeholder="Claim value" class="form-control form-control-sm" required />
                <button type="submit" class="btn btn-sm btn-outline-success">Add Claim</button>
            </form>
        </div>
    </div>
}