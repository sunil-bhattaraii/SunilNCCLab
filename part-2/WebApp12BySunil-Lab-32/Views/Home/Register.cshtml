@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 card p-4 shadow-sm">
        <h2 class="text-center mb-2">Register</h2>
        <p class="text-center text-muted">Sunil Bhattarai | Section B | Roll No. 63/080</p>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Register</button>
        </form>
        <p class="text-muted small mt-2 mb-0">
            New users start with no roles. Admins assign roles and claims from the Admin panel.
        </p>
    </div>
</div>